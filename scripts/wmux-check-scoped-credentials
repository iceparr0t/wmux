#!/usr/bin/env node
import fs from "node:fs";
import os from "node:os";
import path from "node:path";

const usage = () => {
  console.error(`Usage: wmux-check-scoped-credentials [--json] [--metadata-path PATH] [--warn-before SECONDS] [--fail-before SECONDS] [--require]

Read-only check of scoped automation/helper credential expiry metadata.
Exit 0: healthy (or no configured metadata), 1: warning threshold, 2: failure threshold or invalid metadata.`);
};

const args = process.argv.slice(2);
let json = false;
let requireCredentials = false;
let metadataPath = process.env.WMUX_SCOPED_CREDENTIAL_METADATA_PATH
  || path.join(os.homedir(), ".wmux", "scoped-credentials.json");
let warnBeforeSeconds = 7 * 24 * 60 * 60;
let failBeforeSeconds = 24 * 60 * 60;
const nextNumber = (flag, value) => {
  if (!/^\d+$/.test(value ?? "")) throw new Error(`${flag} must be a whole number of seconds`);
  const result = Number(value);
  if (!Number.isSafeInteger(result) || result > 365 * 24 * 60 * 60) throw new Error(`${flag} is out of range`);
  return result;
};
try {
  for (let index = 0; index < args.length; index += 1) {
    switch (args[index]) {
      case "--json": json = true; break;
      case "--require": requireCredentials = true; break;
      case "--metadata-path": metadataPath = args[++index] ?? ""; break;
      case "--warn-before": warnBeforeSeconds = nextNumber("--warn-before", args[++index]); break;
      case "--fail-before": failBeforeSeconds = nextNumber("--fail-before", args[++index]); break;
      case "-h": case "--help": usage(); process.exit(0); break;
      default: throw new Error(`unknown argument: ${args[index]}`);
    }
  }
  if (!path.isAbsolute(metadataPath)) throw new Error("--metadata-path must be absolute");
  if (failBeforeSeconds > warnBeforeSeconds) throw new Error("--fail-before must not exceed --warn-before");
} catch (error) {
  console.error(`wmux scoped credential check failed: ${error instanceof Error ? error.message : "invalid arguments"}`);
  usage();
  process.exit(2);
}

const fail = (message) => {
  const result = { checkedAt: new Date().toISOString(), metadataPath, credentials: [], status: "failed", error: message };
  if (json) console.log(JSON.stringify(result));
  else console.error(`wmux scoped credential check failed: ${message}`);
  process.exit(2);
};

const assertSecure = (filePath) => {
  const stat = fs.lstatSync(filePath);
  if (!stat.isFile() || stat.isSymbolicLink() || fs.realpathSync(filePath) !== path.resolve(filePath)) fail("metadata must be a regular non-symlink file");
  if (typeof process.getuid === "function" && stat.uid !== process.getuid()) fail("metadata must be owned by the current user");
  if ((stat.mode & 0o777) !== 0o600) fail("metadata permissions must be 0600");
};

const now = Date.now();
const report = { checkedAt: new Date(now).toISOString(), metadataPath, credentials: [], status: "ok" };
let metadataEntry;
try {
  metadataEntry = fs.lstatSync(metadataPath);
} catch (error) {
  if (!error || typeof error !== "object" || error.code !== "ENOENT") {
    fail("metadata path could not be inspected safely");
  }
}
if (!metadataEntry) {
  report.status = requireCredentials ? "failed" : "not_configured";
  if (json) console.log(JSON.stringify(report));
  else console.log(`wmux scoped credentials: ${requireCredentials ? "FAILED (metadata not configured)" : "not configured"}`);
  process.exit(requireCredentials ? 2 : 0);
}

try {
  assertSecure(metadataPath);
  const parsed = JSON.parse(fs.readFileSync(metadataPath, "utf8"));
  const isObject = (value) => Boolean(value) && typeof value === "object" && !Array.isArray(value);
  const hasExactKeys = (value, expected) => {
    const actual = Object.keys(value).sort();
    return actual.length === expected.length && expected.slice().sort().every((key, index) => key === actual[index]);
  };
  if (!isObject(parsed) || !hasExactKeys(parsed, ["schemaVersion", "credentials"])
    || parsed.schemaVersion !== 1 || !isObject(parsed.credentials)
    || Object.keys(parsed.credentials).some((kind) => kind !== "automation" && kind !== "helper")) {
    fail("metadata schema is invalid");
  }
  for (const kind of ["automation", "helper"]) {
    const record = parsed.credentials[kind];
    if (record === undefined) continue;
    if (!isObject(record) || !hasExactKeys(record, ["tokenDigest", "issuedAt", "expiresAt"])
      || typeof record.tokenDigest !== "string" || !/^[a-f0-9]{64}$/.test(record.tokenDigest)
      || typeof record.issuedAt !== "number" || !Number.isSafeInteger(record.issuedAt) || record.issuedAt < 0
      || typeof record.expiresAt !== "number" || !Number.isSafeInteger(record.expiresAt) || record.expiresAt <= 0
      || record.issuedAt > record.expiresAt) fail(`metadata record for ${kind} is invalid`);
    const remainingSeconds = Math.floor((record.expiresAt - now) / 1000);
    const status = remainingSeconds <= failBeforeSeconds ? "failed"
      : remainingSeconds <= warnBeforeSeconds ? "warning" : "ok";
    report.credentials.push({ kind, issuedAt: new Date(record.issuedAt).toISOString(), expiresAt: new Date(record.expiresAt).toISOString(), remainingSeconds, status });
  }
} catch (error) {
  if (error instanceof SyntaxError) fail("metadata is not valid JSON");
  fail(error instanceof Error ? error.message : "metadata could not be read");
}

if (report.credentials.length === 0) report.status = requireCredentials ? "failed" : "not_configured";
else if (report.credentials.some((credential) => credential.status === "failed")) report.status = "failed";
else if (report.credentials.some((credential) => credential.status === "warning")) report.status = "warning";

if (json) console.log(JSON.stringify(report));
else {
  console.log(`wmux scoped credentials: ${report.status.toUpperCase()}`);
  for (const credential of report.credentials) {
    console.log(`${credential.kind}: ${credential.status.toUpperCase()} expires ${credential.expiresAt} (${credential.remainingSeconds}s remaining)`);
  }
}
process.exit(report.status === "failed" ? 2 : report.status === "warning" ? 1 : 0);
